{
  "name": "ph-sss-contributions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "example": "npm run build && node examples/monthly-payroll.mjs && node examples/member-categories.mjs",
    "build:web-sample": "npm run build && node scripts/build-web-sample.mjs",
    "check:web-sample": "node scripts/build-web-sample.mjs --check",
    "build:api-seed": "npm run build && node scripts/build-api-seed.mjs",
    "check:api-seed": "npm run build && node scripts/build-api-seed.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/*": "./data/*"
  }
}
